PORT=3001
ADMIN_EMAIL=fabricio@dintegi.com.ar
# Generar con npm run password; pegar el resultado, nunca la contraseña.
ADMIN_PASSWORD_HASH=
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=
FRONTEND_ORIGINS=http://localhost:5173,https://www.dintegi.com.ar,https://dintegi.com.ar
# URL pública HTTPS del BACKEND para los enlaces de baja.
PUBLIC_API_URL=http://localhost:3001
MAIL_FROM=fabricio@dintegi.com.ar
MAIL_FROM_NAME=Fabricio Dimani | DINTEGI
MAIL_REPLY_TO=fabricio@dintegi.com.ar
TEST_EMAIL=fabricio@dintegi.com.ar
# SMTP de un proveedor que admita tu campaña, NO el SMTP de Zoho Mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Activar únicamente después de configurar y autenticar el proveedor.
MAIL_ENABLED=false
# Tope interno por hora móvil; no sustituye los límites del proveedor.
HOURLY_LIMIT=50
SEND_INTERVAL_MS=1500
DATA_DIR=./data
